// Cloudflare config: a Worker (worker/index.ts) that answers /api/*, keeping
// the shared high scores in D1, and serves the built game from dist/ for
// everything else.
{
  "name": "body-quiz",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // wrangler deploy creates this database on first deploy, or binds the
      // existing one with this name. The Worker creates its table on first use.
      "database_name": "body-quiz-scores"
    }
  ]
}
